---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({
    params: { slug: tool.id },
    props: { tool },
  }));
}

interface Props {
  tool: CollectionEntry<'tools'>;
}

const { tool } = Astro.props;
const { Content } = await render(tool);

function fmt(date: Date) {
  return date.toISOString().slice(0, 10).replace(/-/g, '.');
}
---
<BaseLayout title={`${tool.data.title} — Balshankar`} description={tool.data.description}>
  <a href="/tools" class="back-link">← tools</a>
  <h1 class="post-title">{tool.data.title}</h1>
  <p class="post-meta">
    {fmt(tool.data.date)} · {tool.data.status}
    {tool.data.tags.length > 0 && <> · {tool.data.tags.join(', ')}</>}
    {tool.data.url && <> · <a href={tool.data.url}>live link</a></>}
  </p>
  <div class="post-body">
    <Content />
  </div>
  <p class="reply-link">
    <a href={`mailto:hello@balshankar.com?subject=re: ${tool.data.title}`}>reply by email →</a>
  </p>
</BaseLayout>
