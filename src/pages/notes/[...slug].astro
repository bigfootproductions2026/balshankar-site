---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content } = await render(note);

function fmt(date: Date) {
  return date.toISOString().slice(0, 10).replace(/-/g, '.');
}
---
<BaseLayout title={`${note.data.title} — Balshankar`}>
  <a href="/notes" class="back-link">← margins</a>
  <h1 class="post-title">{note.data.title}</h1>
  <p class="post-meta">
    {fmt(note.data.date)}
    {note.data.tags.length > 0 && <> · {note.data.tags.join(', ')}</>}
  </p>
  <div class="post-body">
    <Content />
  </div>
  <p class="reply-link">
    <a href={`mailto:hello@balshankar.com?subject=re: ${note.data.title}`}>reply by email →</a>
  </p>
</BaseLayout>
